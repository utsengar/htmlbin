{
  "name": "htmlbin",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-first HTML hosting. Drop HTML, get a URL. htmlbin.dev",
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "deploy": "cf deploy",
    "db:apply:local": "cf d1 raw 63632af3-b786-422b-87bd-bf6e13399ec9 --local --persist-to .wrangler/state \"--sql=$(cat schema.sql)\"",
    "db:apply:remote": "cf d1 raw 63632af3-b786-422b-87bd-bf6e13399ec9 \"--sql=$(cat schema.sql)\"",
    "db:migrate:local": "cf d1 migrations apply 63632af3-b786-422b-87bd-bf6e13399ec9 --local --persist-to .wrangler/state",
    "db:migrate:remote": "cf d1 migrations apply 63632af3-b786-422b-87bd-bf6e13399ec9",
    "db:migrate:list:local": "cf d1 migrations list 63632af3-b786-422b-87bd-bf6e13399ec9 --local --persist-to .wrangler/state",
    "db:migrate:list:remote": "cf d1 migrations list 63632af3-b786-422b-87bd-bf6e13399ec9",
    "setup": "node scripts/setup.mjs",
    "stats": "node scripts/stats.mjs",
    "dashboard": "node scripts/dashboard/server.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "BASE_URL=http://localhost:8787 ./scripts/agent-e2e.sh"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "@sentry/cloudflare": "^10.76.0",
    "hono": "^4.13.3",
    "satori": "^0.26.0",
    "satori-html": "^0.3.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260930.2",
    "cf": "^1.0.0-beta.12",
    "typescript": "5.7.2",
    "wrangler": "4.145.0"
  }
}
